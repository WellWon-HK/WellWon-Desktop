<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Microphone — voice mode in /chat needs getUserMedia to work.
	     Without this key macOS silently denies the WKWebView's request
	     and the permission prompt never appears.

	     Note (v0.1.21+): WKWebView's `webkitSpeechRecognition` is
	     exposed but non-functional for third-party hosts (WebKit
	     Bugzilla #239816, #225298) — the SFSpeechRecognizer binding
	     is gated to Safari.app. We no longer try to use the Web
	     Speech API in the desktop build; the web layer detects the
	     desktop UA and captures audio via MediaRecorder + POSTs it
	     to `/api/transcribe` (router-side Whisper) instead. Only
	     the microphone key (and the audio-input entitlement) is
	     required. NSSpeechRecognitionUsageDescription and the
	     `personal-information.speech-recognition` entitlement were
	     removed in v0.1.21 because they triggered an extra unused
	     permission prompt and never actually unblocked Web Speech. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>WellWon использует микрофон для голосового режима общения с AI-ассистентом.</string>

	<!-- Camera kept open as a stub for future video / face-mode work. -->
	<key>NSCameraUsageDescription</key>
	<string>WellWon может использовать камеру для функций видео-ассистента.</string>
</dict>
</plist>
