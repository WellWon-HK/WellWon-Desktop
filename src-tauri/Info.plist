<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Microphone — voice mode in /chat needs getUserMedia to work.
	     Without this key macOS silently denies the WKWebView's request
	     and the permission prompt never appears. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>WellWon использует микрофон для голосового режима общения с AI-ассистентом.</string>

	<!-- Speech recognition — Web Speech API in WKWebView routes audio
	     through macOS's on-device Speech.framework. WITHOUT this key
	     the framework refuses recognition jobs silently, so the user
	     grants mic access, sees their voice levels move the blob, but
	     the SpeechRecognition.onresult callback never fires and the
	     transcript stays empty. This was the v0.1.19 mic bug — the
	     mic was open but no text came back. -->
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>WellWon использует распознавание речи для преобразования вашего голоса в текст.</string>

	<!-- Camera kept open as a stub for future video / face-mode work. -->
	<key>NSCameraUsageDescription</key>
	<string>WellWon может использовать камеру для функций видео-ассистента.</string>
</dict>
</plist>
