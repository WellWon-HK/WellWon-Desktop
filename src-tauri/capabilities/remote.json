{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "remote-window",
  "description": "Minimal IPC granted to the wellwon.app content loaded in the full-mode window — only window-control surface we explicitly want it to have.",
  "windows": ["main"],
  "remote": {
    "urls": [
      "http://localhost:3005/*",
      "https://wellwon-app-production.up.railway.app/*"
    ]
  },
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "core:window:allow-set-always-on-top",
    "core:window:allow-start-dragging",
    "core:event:default",
    "core:event:allow-emit"
  ]
}
