{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WellWon",
  "version": "0.1.9",
  "identifier": "hk.wellwon.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["wellwon"]
      }
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/WellWon-HK/WellWon-Desktop/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIwMjc1NkQ1NDdBOTAzQTMKUldTakE2bEgxVlluc0JhS2l6c1BYZXBOWWdMV3FsTkdDRldnYWdrald4MlRVNHBLUXFkdm9sRE4K"
    }
  }
}
